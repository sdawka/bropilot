{
  "name": "@bropilot/ontology-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./artyfact/node": "./src/adapters/artyfact/node.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:live": "vitest run test/semantic/live.test.ts",
    "test:route:live": "vitest run test/route/live.test.ts",
    "typecheck": "tsc -p . --noEmit",
    "lint:system": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./bin/ts-resolve.mjs bin/lint.ts",
    "review:change": "node --experimental-transform-types --disable-warning=ExperimentalWarning --import ./bin/ts-resolve.mjs bin/review.ts"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  }
}

--- a/journeys/J.control.unblock.yaml
+++ b/journeys/J.control.unblock.yaml
@@ -0,0 +1,56 @@
+id: J.control.unblock
+name: Remove a block
+actorGoal: Allow contact through the app again after blocking someone
+features:
+- GD.connect
+requirements:
+- S.webapp.operations
+start: u1
+steps:
+- id: u1
+  actor: user
+  action: Open Person for the blocked contact
+  kind: action
+  screen: screen.person
+  next:
+  - to: u2
+  requirementRefs:
+  - S.webapp.operations
+- id: u2
+  actor: user
+  action: Choose Remove block and confirm
+  kind: branch
+  screen: screen.person
+  next:
+  - to: u3
+    when: confirm
+  - to: e2
+    when: cancel
+  requirementRefs:
+  - S.webapp.operations
+- id: u3
+  actor: system
+  action: Delete the Block and resume the paused goal
+  kind: action
+  screen: screen.person
+  operation: operation.block.remove
+  next:
+  - to: e1
+  requirementRefs:
+  - S.webapp.operations
+- id: e1
+  actor: user
+  action: No block in force; connecting again needs a new invitation
+  kind: end
+  screen: screen.person
+  next: []
+  requirementRefs:
+  - S.webapp.operations
+- id: e2
+  actor: user
+  action: Block still in force
+  kind: end
+  screen: screen.person
+  next: []
+  requirementRefs:
+  - S.webapp.operations

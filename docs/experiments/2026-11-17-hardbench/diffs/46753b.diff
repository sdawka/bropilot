--- a/journeys/J.contacts.remove.yaml
+++ b/journeys/J.contacts.remove.yaml
@@ -0,0 +1,56 @@
+id: J.contacts.remove
+name: Delete a contact
+actorGoal: Remove someone I no longer want to keep in touch with
+features:
+- GD.contacts
+requirements:
+- S.webapp.operations
+start: r1
+steps:
+- id: r1
+  actor: user
+  action: Open Person
+  kind: action
+  screen: screen.person
+  next:
+  - to: r2
+  requirementRefs:
+  - S.webapp.operations
+- id: r2
+  actor: user
+  action: Choose Delete contact and confirm
+  kind: branch
+  screen: screen.person
+  next:
+  - to: r3
+    when: confirm
+  - to: e2
+    when: cancel
+  requirementRefs:
+  - S.webapp.operations
+- id: r3
+  actor: system
+  action: Contact, goal and history deleted; pending jobs cancelled
+  kind: action
+  screen: screen.person
+  operation: operation.contact.delete
+  next:
+  - to: e1
+  requirementRefs:
+  - S.webapp.operations
+- id: e1
+  actor: user
+  action: Contact no longer listed in People
+  kind: end
+  screen: screen.people
+  next: []
+  requirementRefs:
+  - S.webapp.operations
+- id: e2
+  actor: user
+  action: Contact unchanged
+  kind: end
+  screen: screen.person
+  next: []
+  requirementRefs:
+  - S.webapp.operations

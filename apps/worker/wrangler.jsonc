{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "bropilot-foundation",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "LOCAL_WORKSPACE": "disabled"
  },
  "durable_objects": {
    "bindings": [
      { "name": "WORLD_AUTHORITY", "class_name": "WorldAuthority" },
      { "name": "LOCAL_WORLD_DIRECTORY", "class_name": "LocalWorldDirectory" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WorldAuthority", "LocalWorldDirectory"]
    }
  ],
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ],
      "fallthrough": true
    }
  ]
}

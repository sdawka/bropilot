{
  "$schema": "https://workers.cloudflare.com/schema/wrangler.json",
  "name": "bropilot",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "FlueRegistry",
        "FlueExplorerAgent"
      ]
    }
  ],
  "vars": {
    "OPENROUTER_API_KEY": ""
  }
}

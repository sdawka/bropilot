    "pinia": "^3.0.0",
    "reka-ui": "^2.10.5",
    "tailwind-merge": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
